# Copy this file to .env and fill in your own values. Never commit .env.
# Supabase dashboard → Connect (top of the page), or Project Settings → Data API / API Keys.
# The Project URL: https:// + your project ID + .supabase.co, nothing after it (not .../rest/v1/).
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# The Publishable key (sb_publishable_...) or legacy "anon public" key, NOT the Secret / service_role key.
SUPABASE_ANON_KEY=YOUR_KEY_HERE
